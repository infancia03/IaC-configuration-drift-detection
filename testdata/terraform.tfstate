{
  "version": 4,
  "terraform_version": "1.9.0",
  "serial": 1,
  "lineage": "abc-123",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "logs",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "attributes": {
            "bucket": "my-logs-bucket",
            "region": "us-east-1",
            "tags": {
              "Environment": "prod",
              "ManagedBy": "terraform"
            },
            "tags_all": {
              "Environment": "prod",
              "ManagedBy": "terraform"
            },
            "versioning": [
              {
                "enabled": true
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "archive",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "attributes": {
            "bucket": "my-archive-bucket",
            "region": "us-east-1",
            "tags": {
              "Environment": "prod"
            },
            "tags_all": {
              "Environment": "prod"
            },
            "versioning": [
              {
                "enabled": false
              }
            ]
          }
        }
      ]
    },
    {
      "mode": "data",
      "type": "aws_caller_identity",
      "name": "current",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "attributes": {
            "account_id": "123456789012"
          }
        }
      ]
    }
  ]
}
